# Copy to .env and fill in. Never commit .env.

# Which provider runs the SRE agent by default: openai | anthropic
LLM_PROVIDER=openai
# Model for LLM_PROVIDER. If empty, <PROVIDER>_MODEL below is used.
LLM_MODEL=

# Default model per provider, used with `kubebreaker run --provider ...` and by the judge
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: reasoning effort (low | medium | high). Anthropic defaults to medium.
LLM_REASONING_EFFORT=
# Max output tokens per turn, including thinking
LLM_MAX_OUTPUT_TOKENS=16000
# Anthropic server-side refusal fallback: default | off. Turns served by a fallback model are
# counted in each result (fallback_turns), so they can be excluded from per-model numbers.
LLM_FALLBACKS=default

# Which provider judges root-cause write-ups. A provider that runs no agent avoids
# self-grading bias. JUDGE_MODEL empty means <PROVIDER>_MODEL.
JUDGE_PROVIDER=google
JUDGE_MODEL=gemini-3.8-flash
# Thinking effort for the judge (Gemini: minimal | low | medium | high)
JUDGE_EFFORT=medium

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Seconds a fault's symptom must persist before the agent is alerted (like a `for:` clause
# on an alerting rule). Recorded in every result; compare only runs with the same value.
ALERT_HOLD_SECONDS=45

# The only kube context the harness may use
KUBE_CONTEXT=kind-kubebreaker
