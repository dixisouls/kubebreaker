# Copy to .env and fill in. Never commit .env.

# Which provider runs the SRE agent: openai | anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=

# Which provider judges root-cause write-ups. Use a different one from the agent to avoid self-grading bias.
JUDGE_PROVIDER=openai
JUDGE_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The only kube context the harness may use
KUBE_CONTEXT=kind-kubebreaker
